# ════════════════════════════════════════════════════════════════════════════
# StudyFlow AI — Environment Configuration
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="StudyFlow AI"
APP_VERSION="2.0.0"
DEBUG=false
ENVIRONMENT=production   # development | staging | production

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Primary database — source of truth for all user data.
DATABASE_URL=postgresql+asyncpg://studyflow:password@localhost:5432/studyflow_ai
# Sync URL for Alembic migrations only (asyncpg doesn't support sync operations).
DATABASE_SYNC_URL=postgresql+psycopg2://studyflow:password@localhost:5432/studyflow_ai

# ─── Security ────────────────────────────────────────────────────────────────
# Used to encrypt/decrypt API keys stored in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Session token lifetime for desktop sessions (seconds).
# Default: 0 = never expires (Discord/Steam style persistent desktop session).
SESSION_TOKEN_LIFETIME_SECONDS=0

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Electron uses file:// or app:// — add both for safety.
# In production narrow this to your actual Electron app origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Email (OTP / Forgot Password) ────────────────────────────────────────────
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=noreply@studyflow.ai
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_TLS=true
MAIL_SSL=false

# OTP expiry time in seconds (10 minutes default)
OTP_EXPIRY_SECONDS=600

# ─── AI Providers (Backend-managed — NEVER stored on the frontend) ────────────
# These are the application-level default keys. Users can add their own via the UI.
DEFAULT_GEMINI_KEY=
DEFAULT_GROQ_KEY=
DEFAULT_OPENAI_KEY=
DEFAULT_ANTHROPIC_KEY=

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
