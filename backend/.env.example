# ==============================================================================
# StudyFlow AI — Environment Configuration Template
#
# Copy this file to .env and fill in ALL required values before running.
# NEVER commit .env to version control.
# Mandatory fields are marked [REQUIRED].
# ==============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="StudyFlow AI"
APP_VERSION="2.0.0"
ENVIRONMENT=production           # development | staging | production
DEBUG=false                      # Must be false in production
ENABLE_API_DOCS=false            # Explicitly toggle /docs, /redoc, /openapi.json (enabled by default in dev & staging)

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1                   # 0.0.0.0 inside Docker
PORT=8000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# [REQUIRED] Primary async database URL
DATABASE_URL=postgresql+asyncpg://studyflow:CHANGE_ME@localhost:5432/studyflow_ai
# [REQUIRED] Sync URL for Alembic migrations (asyncpg does not support sync ops)
DATABASE_SYNC_URL=postgresql+psycopg2://studyflow:CHANGE_ME@localhost:5432/studyflow_ai

# ─── Security ─────────────────────────────────────────────────────────────────
# [REQUIRED] Fernet key for encrypting AI API keys at rest in the database.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# [REQUIRED] Session token signing secret (min 32 random characters)
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_SESSION_SECRET

# [REQUIRED] JWT signing secret (min 32 random characters)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_JWT_SECRET

# JWT token configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours; 0 = no expiry (desktop session)

# Desktop session lifetime: 0 = permanent (Discord/Steam style), non-zero = seconds until force expiry
SESSION_TOKEN_LIFETIME_SECONDS=0

# Allowed hosts (comma-separated, no wildcards in production)
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins.
# Electron desktop uses file:// origin — this is automatically included.
# In production, only list origins that should be trusted.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── AI Providers (Backend-Managed — NEVER exposed to the frontend) ───────────
# At least one of GEMINI_API_KEY or GROQ_API_KEY is recommended for AI features.
# The app runs without them but AI generation will be unavailable.
GEMINI_API_KEY=
GROQ_API_KEY=

# Per-user daily AI request limit (default 50)
AI_DAILY_REQUEST_LIMIT=50

# Deprecated aliases — kept for backward compatibility only.
# Use GEMINI_API_KEY / GROQ_API_KEY going forward.
DEFAULT_GEMINI_KEY=
DEFAULT_GROQ_KEY=
DEFAULT_OPENAI_KEY=
DEFAULT_ANTHROPIC_KEY=

# ─── File Storage ─────────────────────────────────────────────────────────────
# [IMPORTANT] On ephemeral deployments (Docker, cloud), mount a persistent volume
# to this path. All user documents and RAG vector stores live under:
#   ${UPLOAD_DIR}/documents/user_{user_id}/
#   ${UPLOAD_DIR}/vector_store/user_{user_id}/vectors.json
#
# Local development: ./uploads (relative to backend/)
# Docker / production: /app/uploads (mounted as a persistent Docker volume)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ─── Email (OTP / Password Reset) ─────────────────────────────────────────────
# Not required for core functionality. Required for password-reset and OTP flows.
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_FROM=noreply@studyflow.ai
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_TLS=true
MAIL_SSL=false
OTP_EXPIRY_SECONDS=600           # 10 minutes

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ==============================================================================
# PRODUCTION CHECKLIST
# 1. ENVIRONMENT=production
# 2. DEBUG=false
# 3. DATABASE_URL points to a managed PostgreSQL instance
# 4. ENCRYPTION_KEY is a freshly-generated Fernet key (stored in secret manager)
# 5. SESSION_SECRET and JWT_SECRET are long random strings (stored in secret manager)
# 6. UPLOAD_DIR is a mounted persistent volume (not ephemeral container storage)
# 7. GEMINI_API_KEY / GROQ_API_KEY are set for AI features
# 8. CORS_ORIGINS is narrowed to actual trusted origins
# 9. Run: alembic upgrade head  before the first server start
# ==============================================================================
