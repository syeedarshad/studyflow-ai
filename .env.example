# ==============================================================================
# StudyFlow AI — Root Environment Configuration Template
# Copy this file to .env and fill in required values.
# NEVER commit real .env files with credentials to version control.
# ==============================================================================

# PostgreSQL Database
POSTGRES_USER=studyflow
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=studyflow_ai

# Security Secrets (generate random 32+ char strings)
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_SESSION_SECRET
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_JWT_SECRET
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Backend AI Integration
GEMINI_API_KEY=
GROQ_API_KEY=
ENABLE_API_DOCS=true
