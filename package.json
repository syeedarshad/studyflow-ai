{
  "name": "studyflow-ai",
  "version": "1.0.0",
  "description": "StudyFlow AI - Smart Productivity Dashboard for College Students",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder build --win",
    "build:dir": "electron-builder build --win --dir",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.studyflow.ai",
    "productName": "StudyFlow AI",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^38.5.0",
    "electron-builder": "^24.9.1"
  },
  "author": "StudyFlow AI",
  "license": "MIT"
}
